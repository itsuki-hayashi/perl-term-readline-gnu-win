Path::Tiny 0.150: retain all assertions on native Win32 with symlink privileges.
Normalize readlink output through Path::Tiny, and compare relative paths against
the operating system's resolved base directory, including Win32 lexical '..'.
No runtime code changes. Original upstream Apache-2.0 notices remain intact.

--- a/t/filesystem.t
+++ b/t/filesystem.t
@@ -465,2 +465,2 @@
-    is readlink($link2), $link, 'symbolic link is available after spewing';
-    is readlink($link),  $file, 'symbolic link is available after spewing';
+    is path(readlink($link2)), $link, 'symbolic link is available after spewing';
+    is path(readlink($link)),  $file, 'symbolic link is available after spewing';
--- a/t/symlinks.t
+++ b/t/symlinks.t
@@ -27 +27 @@
-    is readlink $bar, "../foo", "the link seems right";
+    is path(readlink $bar), "../foo", "the link seems right";
--- a/t/rel-abs.t
+++ b/t/rel-abs.t
@@ -187 +187,3 @@
-    $expect = $path->relative( $deep->parent->child("F/G")->realpath );
+    # Win32 resolves '..' before traversing directory symlinks. Use the
+    # actual resolved base instead of assuming POSIX traversal semantics.
+    $expect = $path->relative( $base->realpath );
